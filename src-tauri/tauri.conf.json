{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "UkeplanLager",
  "version": "2.0.1",
  "identifier": "com.ukeplanlager.pro",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "UkeplanLager",
        "width": 1200,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../app.py"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMkUyQTQ3REUxQURGODcKUldTSDN4cmVSeW91OHVQKzljKzMvQ0dZZFZNNDFkekhUbzhiM09VdXRpdlNMRnFWUHh5bEg0R0sK",
      "endpoints": [
        "https://github.com/takoie/ukeplan/releases/latest/download/latest.json"
      ]
    }
  }
}
